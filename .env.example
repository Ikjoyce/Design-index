# Optional. Defaults to the platform's per-user application-data directory.
# Windows: %LOCALAPPDATA%/DesignIndex/library
# DESIGN_INDEX_LIBRARY_DIR=C:/Users/you/AppData/Local/DesignIndex/library
DESIGN_INDEX_PORT=4317

# Optional. Defaults to this project's inbox/ folder, independent of the working directory.
# Use an absolute folder path, or off to disable automatic folder intake.
# DESIGN_INDEX_INBOX_DIR=C:/Users/you/Documents/DesignReferences

# Server-side OpenCode Go key. ZEN_API_KEY is accepted as a legacy name.
# Never put secrets in VITE_* variables. Analysis starts automatically with saved sharing consent.
OPENCODE_GO_API_KEY=
