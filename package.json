{
  "name": "design-index",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/server",
    "apps/web",
    "packages/shared",
    "packages/database",
    "packages/palette"
  ],
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @design-index/server\" \"npm run dev -w @design-index/web\"",
    "build": "npm run build -w @design-index/web && npm run build -w @design-index/server",
    "start": "npm run start -w @design-index/server",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:runtime": "node tests/runtime-smoke.mjs",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run typecheck && npm test && npm run build && npm run test:runtime"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.0",
    "vitest": "~4.1.12"
  }
}
